# Firebase Configuration for EcoStride Frontend Template
# Copy this file to frontend/.env

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=eco-stride2026.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eco-stride2026
VITE_FIREBASE_STORAGE_BUCKET=eco-stride2026.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_DATABASE_URL=https://eco-stride2026-default-rtdb.firebaseio.com
