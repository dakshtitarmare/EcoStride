# EcoStride Backend Environment Variables Template
# Copy this file to .env and configure your keys

# --- Firebase Configuration ---
FIREBASE_DATABASE_URL=https://eco-stride2026-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS=eco-stride2026-firebase-adminsdk-fbsvc-1f2810f333.json
USE_LOCAL_STORAGE_FALLBACK=false

# --- API Keys ---
# OpenWeather API: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# AQICN Token: https://aqicn.org/api/
AQICN_API_TOKEN=your_aqicn_token_here

# Groq API: https://console.groq.com/
GROQ_API_KEY=your_groq_key_here

# Gemini API: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_key_here

# Anthropic Claude API: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Govt India Open Data Portal (Data.gov.in)
GOV_INDIA_API_KEY=your_gov_india_key_here
GOV_INDIA_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# --- Email / Alerts (Optional) ---
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password
AUTHORITY_EMAIL=your_email@gmail.com
FAST2SMS_API_KEY=
